<Window x:Class="EditorCAA_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor CAA Professionale" Height="900" Width="1100" 
        Background="#F8F9FA" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="10,5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="Nuovo" Click="Pulisci_Click" Background="Transparent" BorderThickness="0" Margin="5,0" Foreground="#444"/>
                <Button Content="Stampa" Click="Stampa_Click" Background="Transparent" BorderThickness="0" Margin="5,0" Foreground="#444"/>

                <Button Content="Salva in PDF" Click="EsportaPDF_Click" Background="#0078D4" Foreground="White" FontWeight="Bold" Padding="10,2" Margin="10,0" BorderThickness="0"/>

                <Separator Margin="10,5"/>

                <TextBlock Text="Carattere:" VerticalAlignment="Center" Margin="5,0" Foreground="#666"/>
                <ComboBox x:Name="ComboFont" Width="130" Margin="5,0" SelectedIndex="0" SelectionChanged="Parametro_Changed">
                    <ComboBoxItem Content="Arial" FontFamily="Arial"/>
                    <ComboBoxItem Content="Verdana" FontFamily="Verdana"/>
                    <ComboBoxItem Content="Segoe UI" FontFamily="Segoe UI"/>
                    <ComboBoxItem Content="Comic Sans MS" FontFamily="Comic Sans MS"/>
                </ComboBox>

                <TextBlock Text="Dim.:" VerticalAlignment="Center" Margin="5,0" Foreground="#666"/>
                <ComboBox x:Name="ComboSize" Width="60" Margin="5,0" SelectedIndex="1" SelectionChanged="Parametro_Changed">
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="12"/>
                    <ComboBoxItem Content="14"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="20"/>
                </ComboBox>

                <Separator Margin="10,5"/>

                <Button Content="Sinistra" Click="Align_Click" Tag="Left" Margin="5,0" Padding="10,2"/>
                <Button Content="Centro" Click="Align_Click" Tag="Center" Margin="5,0" Padding="10,2"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Background="#F8F9FA" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Margin="0,30">
                <Border x:Name="AreaFoglio" Background="White" Width="793" MinHeight="1122" Padding="50" CornerRadius="1" BorderThickness="1" BorderBrush="#D1D1D1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2" Color="Black"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBox x:Name="InputParola" 
                                 FontSize="19" 
                                 FontFamily="Arial"
                                 BorderThickness="0" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True"
                                 TextChanged="InputParola_TextChanged"
                                 Background="Transparent"
                                 Margin="0,0,0,50"/>

                        <WrapPanel x:Name="ContenitoreImmagini" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>